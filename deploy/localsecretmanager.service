[Unit]
Description=LocalSecretManager (password manager web app)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=accdev-01
Group=accdev-01
WorkingDirectory=/home/accdev-01/LocalSecretManager
Environment="PYTHONUNBUFFERED=1"
ExecStart=/usr/bin/python3 server.py 6300
TimeoutStopSec=10
Restart=on-failure
RestartSec=5

# 秘密情報を扱うため最小限のサンドボックス
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

StandardOutput=journal
StandardError=journal
SyslogIdentifier=localsecretmanager

[Install]
WantedBy=multi-user.target
